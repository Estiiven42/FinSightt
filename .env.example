# SUPABASE_URL: The URL of your Supabase project.
SUPABASE_URL="https://cmjvnzsypxhtscccfmqw.supabase.co"
# SUPABASE_DB_URL: The connection string for the PostgreSQL database.
SUPABASE_DB_URL="postgres://your_username:your_password@your_host:5432/postgres"

# JWT_SECRET: Secret for signing JWT tokens.
JWT_SECRET="YourSecretKeyHere"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLIENT_ID: Your Google API Console OAuth Client ID
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET: Your Google API Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# APP_URL: The public base URL of the application. Required on Render to match Google OAuth callbacks correctly (e.g., https://yourbase.onrender.com)
APP_URL=
